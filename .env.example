# Ambiente: em produção, SECRET_KEY passa a ser obrigatória e cookies Secure/HSTS são ativados.
APP_ENV=production

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Banco. Deixe vazio para SQLite local em instance/exposibot.db.
# Exemplo PostgreSQL: postgresql+psycopg://usuario:senha@host/banco
# Exemplo MySQL: mysql+pymysql://usuario:senha@host/banco
DATABASE_URL=

# Provedores de IA. Configure ao menos um.
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Tavily é usado como fonte curada/fallback de busca.
TAVILY_API_KEY=

# Rate limiting. memory:// é adequado para um único worker; para múltiplos workers use Redis.
RATELIMIT_STORAGE_URI=memory://

# Token opcional da API A Bíblia Digital.
BIBLE_API_TOKEN=
