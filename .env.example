# Chave secreta do Flask (sessões, login). Gere uma nova com:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Provedores de IA (configure ao menos um; o app usa fallback automático entre eles)
GROQ_API_KEY=
GEMINI_API_KEY=

# Busca "fundamentada" (grounding) em sites teológicos reformados. Opcional.
TAVILY_API_KEY=

# Token opcional da API "A Bíblia Digital" (abibliadigital.com.br) para
# remover o limite de 20 requisições/hora do uso anônimo. Registre-se
# gratuitamente em https://www.abibliadigital.com.br/ se precisar.
BIBLE_API_TOKEN=
